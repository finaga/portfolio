{
  "trailingSlash": true,
  "rewrites": [
    { "source": "/probe-root", "destination": "/favicon.svg" },
    { "source": "/probe-deep/:path*", "destination": "/favicon.svg" },
    { "source": "/gallery/:path*", "destination": "/gallery/" },
    { "source": "/portfolio-v3/:path*", "destination": "/portfolio-v3/index.html" },
    { "source": "/portfolio-v3/:path*/", "destination": "/portfolio-v3/index.html" }
  ],
  "headers": [
    {
      "source": "/portfolio/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/gallery/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/portfolio-v3/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/portfolio-v3/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/manual/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
